<h1><%= @product.name %></h1>

<% if @product.image.attached? %>
  <%= image_tag @product.image, alt: @product.name, width: 400 %>
<% end %>

<p>
  <strong>Descripción:</strong>
  <%= @product.description %>
</p>

<p>
  <strong>Precio:</strong>
  $<%= @product.price %>
</p>

<p>
  <strong>Stock:</strong>
  <%= @product.stock %>
</p>

<p>
  <strong>Categoría:</strong>
  <%= @product.category.name %>
</p>

<hr>

<%= link_to "Editar",
    edit_artist_product_path(@product) %>

|

<%= link_to "Volver a mis productos",
    artist_products_path %>