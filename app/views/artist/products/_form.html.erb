<%= form_with model: [:artist, @product], html: { multipart: true } do |form| %>

  <% if @product.errors.any? %>
    <div>
      <h2>No se pudo guardar el producto:</h2>

      <ul>
        <% @product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name %>
  </div>

  <br>

  <div>
    <%= form.label :description, "Descripción" %>
    <%= form.text_area :description %>
  </div>

  <br>

  <div>
    <%= form.label :price, "Precio" %>
    <%= form.number_field :price, step: 0.01 %>
  </div>

  <br>

  <div>
    <%= form.label :stock, "Stock" %>
    <%= form.number_field :stock %>
  </div>

  <br>

  <div>
    <%= form.label :image, "Imagen del producto" %>
    <%= form.file_field :image, accept: "image/png,image/jpeg,image/webp" %>
  </div>

  <br>

  <div>
    <%= form.label :category_id, "Categoría" %>

    <%= form.collection_select :category_id,
        Category.all,
        :id,
        :name,
        { prompt: "Seleccionar categoría" } %>
  </div>

  <br>

  <div>
    <%= form.submit %>
  </div>

<% end %>