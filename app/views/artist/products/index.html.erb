<h1>Mis productos</h1>

<p>
  <%= link_to "Mis productos", artist_products_path %>
</p>

<hr>

<%= link_to "Nuevo producto", new_artist_product_path %>

<hr>

<% if @products.any? %>

  <% @products.each do |product| %>

    <div>
      <h2><%= product.name %></h2>

      <p>
        <strong>Descripción:</strong>
        <%= product.description %>
      </p>

      <p>
        <strong>Precio:</strong>
        $<%= product.price %>
      </p>

      <p>
        <strong>Stock:</strong>
        <%= product.stock %>
      </p>

      <p>
        <strong>Categoría:</strong>
        <%= product.category.name %>
      </p>

      <%= link_to "Ver",
          artist_product_path(product) %>

      |

      <%= link_to "Editar",
          edit_artist_product_path(product) %>

      |

      <%= link_to "Eliminar",
          artist_product_path(product),
          data: {
            turbo_method: :delete,
            turbo_confirm: "¿Seguro que querés eliminar este producto?"
          } %>
    </div>

    <hr>

  <% end %>

<% else %>

  <p>Todavía no tenés productos publicados.</p>

<% end %>