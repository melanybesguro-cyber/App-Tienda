<h1>Categorías</h1>

<%= link_to "Nueva categoría", new_admin_category_path %>

<hr>

<% if @categories.any? %>

  <% @categories.each do |category| %>

    <div>
      <h2><%= category.name %></h2>

      <p>
        <strong>Descripción:</strong>
        <%= category.description %>
      </p>

      <%= link_to "Ver", admin_category_path(category) %>
      |
      <%= link_to "Editar", edit_admin_category_path(category) %>
      |
      <%= link_to "Eliminar",
          admin_category_path(category),
          data: {
            turbo_method: :delete,
            turbo_confirm: "¿Seguro que querés eliminar esta categoría?"
          } %>
    </div>

    <hr>

  <% end %>

<% else %>

  <p>No hay categorías cargadas.</p>

<% end %>