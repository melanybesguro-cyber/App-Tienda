<div class="artelier-page">
  <div class="artelier-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <p class="artelier-eyebrow">ADMINISTRACIÓN</p>
      <h1>Usuarios</h1>
      <p class="artelier-subtitle">
        Gestión de las cuentas registradas en la plataforma.
      </p>
    </div>
  </div>

  <div class="artelier-toolbar">
    <div>
      <h2>Listado de usuarios</h2>
    </div>
    <span class="artelier-counter">
      <%= @users.size %> <%= @users.size == 1 ? "usuario registrado" : "usuarios registrados" %>
    </span>
  </div>

  <% if @users.any? %>
    <div class="artelier-product-grid">
      <% @users.each do |user| %>
        <article class="artelier-product-card" style="padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div class="artelier-product-content" style="padding: 0;">
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h3 style="margin: 0;"><%= user.name %></h3>
              <span style="padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem; background-color: #e9ecef; color: #495057; font-weight: bold; text-transform: uppercase;">
                <%= user.role %>
              </span>
            </div>

            <div style="margin-bottom: 1.5rem; color: #555; font-size: 0.95rem;">
              <p style="margin-bottom: 0;">
                <strong style="color: #333;">Email:</strong> <%= user.email %>
              </p>
            </div>

            <div class="artelier-product-actions" style="border-top: 1px solid #eee; padding-top: 1rem; display: flex;">
              <%= link_to "Ver detalles", admin_user_path(user), class: "artelier-button artelier-button-outline", style: "flex: 1; text-align: center; padding: 0.4rem;" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="artelier-empty">
      <div class="artelier-empty-icon">✧</div>
      <h2>No hay usuarios registrados</h2>
      <p>Aún no se han registrado cuentas en el sistema.</p>
    </div>
  <% end %>
</div>