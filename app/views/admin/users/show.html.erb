<h1><%= @user.name %></h1>

<p>
  <strong>Email:</strong>
  <%= @user.email %>
</p>

<p>
  <strong>Rol:</strong>
  <%= @user.role %>
</p>

<hr>

<h2>Pedidos</h2>

<% if @user.orders.any? %>

  <% @user.orders.each do |order| %>
    <p>
      <%= link_to "Pedido ##{order.id}", admin_order_path(order) %>
      - <%= order.status %>
    </p>
  <% end %>

<% else %>

  <p>Este usuario todavía no tiene pedidos.</p>

<% end %>

<hr>

<h2>Comisiones</h2>

<% if @user.commissions.any? %>

  <% @user.commissions.each do |commission| %>
    <p>
      Comisión #<%= commission.id %>
      - <%= commission.status %>
    </p>
  <% end %>

<% else %>

  <p>Este usuario todavía no tiene comisiones.</p>

<% end %>

<hr>

<%= link_to "Volver a usuarios", admin_users_path %>