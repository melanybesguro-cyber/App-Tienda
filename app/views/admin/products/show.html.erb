<h1><%= @product.name %></h1>

<% if @product.image.attached? %>
  <p>
    <%= image_tag @product.image, alt: @product.name, width: 400 %>
  </p>
<% end %>

<p>
  <strong>Descripción:</strong>
  <%= @product.description %>
</p>

<p>
  <strong>Precio:</strong>
  $<%= @product.price %>
</p>

<p>
  <strong>Stock:</strong>
  <%= @product.stock %>
</p>

<p>
  <strong>Artista:</strong>
  <%= @product.artist&.name || "Sin artista asignado" %>
</p>

<p>
  <strong>Categoría:</strong>
  <%= @product.category.name %>
</p>

<hr>

<%= link_to "Editar", edit_admin_product_path(@product) %>

|

<%= link_to "Volver a productos", admin_products_path %>